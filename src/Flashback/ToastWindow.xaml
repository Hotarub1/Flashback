<Window x:Class="Flashback.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="None"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        IsHitTestVisible="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border x:Name="Panel" Margin="12" Padding="14,10,18,10" CornerRadius="10" Background="#F2141418"
            BorderBrush="#33FFFFFF" BorderThickness="1" MinWidth="220" MaxWidth="420">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Dot" Width="10" Height="10" CornerRadius="5" Background="#DB2777" VerticalAlignment="Center" Margin="0,0,12,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                <TextBlock x:Name="DetailText" Foreground="#B8B8C4" FontSize="12" FontFamily="Segoe UI" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
