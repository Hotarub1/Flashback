<Window x:Class="Flashback.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="None"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" Focusable="False"
        IsHitTestVisible="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border x:Name="Panel" Margin="12" Padding="16,12,20,12" Background="#F24B3832" BorderBrush="#33F5E6CA" BorderThickness="1"
            MinWidth="220" MaxWidth="420">
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Dot" Width="8" Height="8" CornerRadius="4" Background="#FFFCF7" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Foreground="#FFFCF7" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                <TextBlock x:Name="DetailText" Foreground="#DCC7AA" FontSize="13" FontFamily="{StaticResource SerifFont}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
