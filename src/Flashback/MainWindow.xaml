<Window x:Class="Flashback.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flashback"
        Title="Flashback" Width="1140" Height="740" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="/Assets/icon.ico"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ContextMenu x:Key="ClipMenu">
            <MenuItem Header="Play" Click="MenuPlay_Click"/>
            <MenuItem Header="Open in default player" Click="MenuOpenExternal_Click"/>
            <MenuItem Header="Show in folder" Click="MenuShowInFolder_Click"/>
            <Separator/>
            <MenuItem Header="Rename…" Click="MenuRename_Click"/>
            <MenuItem Header="Delete" Click="MenuDelete_Click"/>
        </ContextMenu>

        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="Background" Value="#202027"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PlainItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,7,0,7"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="20,16,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/logo.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Flashback" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <Button x:Name="SaveClipButton" Grid.Column="2" Style="{StaticResource PrimaryButton}" Click="SaveClip_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE714;" VerticalAlignment="Center" Margin="0,1,8,0"/>
                    <TextBlock x:Name="SaveClipText" Text="Save clip"/>
                </StackPanel>
            </Button>
        </Grid>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="12,0,12,0" Background="Transparent" BorderThickness="0">
            <!-- ============================== Clips ============================== -->
            <TabItem Header="Clips">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="8,12,8,6">
                        <Button DockPanel.Dock="Right" Content="Open folder" Click="OpenFolder_Click"/>
                        <TextBlock x:Name="ClipCountText" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="13"/>
                    </DockPanel>

                    <ListBox x:Name="ClipList" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0"
                             ItemContainerStyle="{StaticResource PlainItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Tile}" Width="262" ContextMenu="{StaticResource ClipMenu}"
                                        MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseLeave="Tile_MouseLeave"
                                        MouseLeftButtonUp="Tile_MouseLeftButtonUp" ToolTip="{Binding Name}">
                                    <StackPanel>
                                        <Grid Height="147" Background="#0B0B0D">
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="0,0,260,160" RadiusX="7" RadiusY="7"/>
                                            </Grid.Clip>
                                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE714;" FontSize="30" Foreground="#33FFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"/>
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,2" CornerRadius="4" Background="#CC000000">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DurationText}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding DurationText}" Foreground="White" FontSize="12"/>
                                            </Border>
                                        </Grid>
                                        <StackPanel Margin="10,8,10,10">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel x:Name="EmptyState" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE714;" FontSize="44" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center"/>
                        <TextBlock Text="No clips yet" Foreground="{StaticResource TextPrimary}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                        <TextBlock x:Name="EmptyHint" Foreground="{StaticResource TextMuted}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>

                    <Button x:Name="ShowMoreButton" Grid.Row="2" Content="Show more clips" HorizontalAlignment="Center" Margin="0,6,0,8"
                            Visibility="Collapsed" Click="ShowMore_Click"/>
                </Grid>
            </TabItem>

            <!-- ============================== Settings ============================== -->
            <TabItem x:Name="SettingsTab" Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                    <StackPanel Margin="8,12,8,16" MaxWidth="860" HorizontalAlignment="Left" Width="860">

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Clips"/>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Save folder"/>
                                    <TextBox x:Name="SaveFolderBox" Grid.Column="1" IsReadOnly="True" VerticalAlignment="Center"/>
                                    <Button Grid.Column="2" Content="Browse…" Margin="8,0,0,0" Click="BrowseFolder_Click"/>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Clip hotkey"/>
                                    <Button x:Name="HotkeyButton" Grid.Column="1" MinWidth="200" Click="HotkeyButton_Click"
                                            PreviewKeyDown="HotkeyButton_PreviewKeyDown" LostKeyboardFocus="HotkeyButton_LostFocus"
                                            ToolTip="Click, then press the keys you want"/>
                                    <TextBlock x:Name="HotkeyStatus" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Clip length"/>
                                    <ComboBox x:Name="LengthBox" Grid.Column="1" MinWidth="200" SelectionChanged="Setting_Changed"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Text="How far back a clip reaches when you press the hotkey."/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Video"/>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Quality"/>
                                    <ComboBox x:Name="QualityBox" Grid.Column="1" MinWidth="200" SelectionChanged="Setting_Changed"/>
                                    <TextBlock x:Name="QualityHint" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Clip resolution"/>
                                    <ComboBox x:Name="ResolutionBox" Grid.Column="1" MinWidth="200" SelectionChanged="Setting_Changed"/>
                                    <TextBlock Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Text="Smaller sizes are converted while saving, which takes a few seconds longer."/>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Frame rate"/>
                                    <ComboBox x:Name="FpsBox" Grid.Column="1" MinWidth="200" SelectionChanged="Setting_Changed"/>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Mouse cursor"/>
                                    <CheckBox x:Name="CursorCheck" Grid.Column="1" Content="Show the cursor in clips" Click="Setting_Changed"/>
                                </Grid>
                                <TextBlock x:Name="BufferHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Audio"/>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Desktop audio"/>
                                    <CheckBox x:Name="DesktopCheck" Grid.Column="1" Content="Record game and PC sound" Click="Setting_Changed"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <ProgressBar x:Name="DesktopMeter" Width="120" Height="4" Minimum="0" Maximum="1"/>
                                        <TextBlock x:Name="DesktopInfo" Style="{StaticResource Hint}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="290"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Separate app tracks" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                    <StackPanel Grid.Column="1">
                                        <CheckBox x:Name="AppsCheck" Content="Give each app its own audio track (turn Discord down without touching the game)" Click="Setting_Changed"/>
                                        <TextBlock x:Name="AppsInfo" Style="{StaticResource Hint}" Margin="26,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Microphone"/>
                                    <CheckBox x:Name="MicCheck" Grid.Column="1" Content="Record my microphone" Click="Setting_Changed"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <ProgressBar x:Name="MicMeter" Width="120" Height="4" Minimum="0" Maximum="1"/>
                                        <TextBlock x:Name="MicInfo" Style="{StaticResource Hint}" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="290"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Microphone device"/>
                                    <ComboBox x:Name="MicDeviceBox" Grid.Column="1" MinWidth="320" HorizontalAlignment="Left"
                                              SelectionChanged="Setting_Changed" DropDownOpened="MicDeviceBox_DropDownOpened"/>
                                </Grid>
                                <Grid Style="{StaticResource SettingRow}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource RowLabel}" Text="Microphone volume"/>
                                    <Slider x:Name="MicVolumeSlider" Grid.Column="1" Width="220" Minimum="0" Maximum="200" SmallChange="5" LargeChange="25"
                                            VerticalAlignment="Center" ValueChanged="MicVolume_Changed"/>
                                    <TextBlock x:Name="MicVolumeText" Grid.Column="2" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="General"/>
                                <CheckBox x:Name="StartupCheck" Content="Start with Windows (in the background)" Margin="0,4" Click="Setting_Changed"/>
                                <CheckBox x:Name="TrayCheck" Content="Keep running in the tray when the window is closed" Margin="0,4" Click="Setting_Changed"/>
                                <CheckBox x:Name="SoundCheck" Content="Play a sound when the clip hotkey is pressed" Margin="0,4" Click="Setting_Changed"/>
                                <StackPanel Margin="26,2,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Sound:" Style="{StaticResource Hint}" FontSize="13" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="SoundNameText" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center"
                                                   Margin="6,0,0,0" MaxWidth="300" TextTrimming="CharacterEllipsis"/>
                                        <Button x:Name="ChooseSoundButton" Content="Choose sound…" Margin="14,0,0,0" Click="ChooseSound_Click"/>
                                        <Button x:Name="PreviewSoundButton" Content="Play" Margin="8,0,0,0" Click="PreviewSound_Click"/>
                                        <Button x:Name="DefaultSoundButton" Content="Use default" Margin="8,0,0,0" Click="DefaultSound_Click"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                               Text="Use any audio file (WAV, MP3, OGG, FLAC, M4A…). Only its first 5 seconds are played. Clip audio ends at the moment you press the hotkey, so the sound is not in the clip."/>
                                </StackPanel>
                                <CheckBox x:Name="ToastCheck" Content="Show an on-screen notice when a clip is saved" Margin="0,4" Click="Setting_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Content="Open log folder" Click="OpenLogs_Click"/>
                                    <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="0,1,0,0" Padding="20,9" Background="#0D0D10">
            <DockPanel>
                <TextBlock x:Name="AudioStatusText" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusDetail" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Player overlay -->
        <Grid x:Name="PlayerOverlay" Grid.RowSpan="3" Background="#FF0B0B0D" Visibility="Collapsed" MouseMove="PlayerOverlay_MouseMove">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <DockPanel x:Name="PlayerHeader" Margin="20,14,20,8">
                <Button DockPanel.Dock="Right" Click="PlayerClose_Click" ToolTip="Close (Esc)">
                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8BB;" FontSize="12"/>
                </Button>
                <Button DockPanel.Dock="Right" Content="Delete" Margin="0,0,8,0" Click="PlayerDelete_Click"/>
                <Button DockPanel.Dock="Right" Content="Show in folder" Margin="0,0,8,0" Click="PlayerShowInFolder_Click"/>
                <TextBlock x:Name="PlayerTitle" Foreground="{StaticResource TextPrimary}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>

            <Grid x:Name="PlayerSurface" Grid.Row="1" Background="Black" MouseLeftButtonDown="PlayerSurface_MouseDown">
                <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform" ScrubbingEnabled="True"
                              MediaOpened="Player_MediaOpened" MediaEnded="Player_MediaEnded" MediaFailed="Player_MediaFailed"/>
                <TextBlock x:Name="PlayerError" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextAlignment="Center" Visibility="Collapsed"/>
            </Grid>

            <!-- Transport bar: the buttons, then the seek bar right above the timeline, starting and ending where the
                 timeline does so both show the same moment at the same place. In full screen the bar floats over the
                 bottom of the video with the seek bar on top across the whole width, and hides when the mouse rests. -->
            <Border x:Name="ControlBar" Grid.Row="2" Padding="20,10,20,8" Background="#FF0B0B0D">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid x:Name="TransportRow">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Width="36" Height="32" Padding="0" Click="ToStart_Click" ToolTip="Start (Home)">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE892;" FontSize="13"/>
                            </Button>
                            <Button Width="36" Height="32" Padding="0" Margin="4,0,0,0" Click="FrameBack_Click" ToolTip="One frame back (comma)">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76B;" FontSize="13"/>
                            </Button>
                            <Button x:Name="PlayPauseButton" Width="44" Height="32" Padding="0" Margin="4,0,0,0" Click="PlayPause_Click" ToolTip="Play / pause (Space)">
                                <TextBlock x:Name="PlayPauseGlyph" FontFamily="{StaticResource Icons}" Text="&#xE769;" FontSize="14"/>
                            </Button>
                            <Button Width="36" Height="32" Padding="0" Margin="4,0,0,0" Click="FrameForward_Click" ToolTip="One frame forward (period)">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE76C;" FontSize="13"/>
                            </Button>
                            <Button Width="36" Height="32" Padding="0" Margin="4,0,0,0" Click="ToEnd_Click" ToolTip="End (End)">
                                <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE893;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="MuteButton" Width="36" Height="32" Padding="0" Click="Mute_Click" ToolTip="Mute (M)">
                                <TextBlock x:Name="MuteGlyph" FontFamily="{StaticResource Icons}" Text="&#xE995;" FontSize="13"/>
                            </Button>
                            <!-- Listening volume for the whole clip. The per-track sliders below set what a saved trim contains. -->
                            <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10"
                                    VerticalAlignment="Center" Margin="6,0,6,0" IsMoveToPointEnabled="True" Focusable="False"
                                    ValueChanged="Volume_ValueChanged" PreviewMouseWheel="Volume_MouseWheel"
                                    ToolTip="Volume (Up / Down, or the mouse wheel). Saved trims are not affected."/>
                            <Button x:Name="FullscreenButton" Width="36" Height="32" Padding="0" Margin="4,0,0,0" Click="Fullscreen_Click" ToolTip="Full screen (F)">
                                <TextBlock x:Name="FullscreenGlyph" FontFamily="{StaticResource Icons}" Text="&#xE740;" FontSize="13"/>
                            </Button>
                        </StackPanel>
                        <StackPanel x:Name="TrimPanel" Grid.Column="3" Orientation="Horizontal" Margin="16,0,0,0">
                            <ProgressBar x:Name="ExportProgress" Width="110" Height="6" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                            <Button x:Name="SaveTrimButton" Style="{StaticResource PrimaryButton}" Padding="14,6" Click="SaveTrim_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8C6;" VerticalAlignment="Center" Margin="0,1,8,0"/>
                                    <TextBlock Text="Save trim"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- The time sits in the timeline's label column; the seek bar spans the timeline's own column. -->
                    <Grid x:Name="SeekRow" Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="SeekLabelColumn" Width="{x:Static local:MainWindow.TrackLabelWidth}"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock x:Name="PlayerTime" Foreground="{StaticResource TextPrimary}" FontSize="12" Text="0:00"/>
                            <TextBlock Foreground="{StaticResource TextMuted}" FontSize="12" Text=" / "/>
                            <TextBlock x:Name="PlayerTotal" Foreground="{StaticResource TextMuted}" FontSize="12" Text="0:00"/>
                        </StackPanel>
                        <!-- Its margin is set in code: widened by half a thumb at each end, so 0:00 and the end are where the timeline has them. -->
                        <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" IsMoveToPointEnabled="True"
                                Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" ValueChanged="Seek_ValueChanged"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Timeline: volume per track on the left, the ruler, video bar and waveforms on the right. Row heights match the control. -->
            <Grid x:Name="TimelinePanel" Grid.Row="3" Margin="20,2,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{x:Static local:MainWindow.TrackLabelWidth}"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <Grid Height="{x:Static local:TimelineControl.RulerHeight}">
                        <TextBlock x:Name="TrimInfo" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Border Height="{x:Static local:TimelineControl.VideoHeight}" Margin="0,4,0,0" Background="#222229" CornerRadius="4" Padding="10,0">
                        <TextBlock Text="Video" Foreground="{StaticResource TextPrimary}" FontSize="12" VerticalAlignment="Center"/>
                    </Border>
                    <!-- One row per audio track (each app, the microphone), filled in when a clip opens. -->
                    <StackPanel x:Name="TrackRows"/>
                </StackPanel>
                <local:TimelineControl x:Name="Timeline" Grid.Column="1" VerticalAlignment="Top" Focusable="True"/>
                <Border x:Name="AudioNote" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0" Padding="8,2" CornerRadius="4"
                        Background="#CC1A1A1F" Visibility="Collapsed">
                    <TextBlock x:Name="AudioNoteText" Foreground="{StaticResource Warn}" FontSize="11"/>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
