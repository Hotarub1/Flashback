<Window x:Class="Flashback.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flashback"
        xmlns:core="clr-namespace:Flashback.Core"
        Title="Flashback" Width="1140" Height="740" MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterScreen" Icon="/Assets/icon.ico"
        Background="{StaticResource CreamBrush}" Foreground="{StaticResource EspressoBrush}" FontFamily="{StaticResource SerifFont}"
        PreviewKeyDown="Window_PreviewKeyDown" StateChanged="Window_StateChanged">
    <!-- The header doubles as the title bar: the window chrome is set up in code (see MainWindow.ApplyChrome). -->
    <Window.Resources>
        <ContextMenu x:Key="ClipMenu">
            <MenuItem Header="Play" Click="MenuPlay_Click"/>
            <MenuItem Header="Open in default player" Click="MenuOpenExternal_Click"/>
            <MenuItem Header="Show in folder" Click="MenuShowInFolder_Click"/>
            <Separator/>
            <MenuItem Header="Rename…" Click="MenuRename_Click"/>
            <MenuItem Header="Delete" Click="MenuDelete_Click"/>
        </ContextMenu>

        <!-- A clip's thumbnail, edge to edge with its neighbours (sized by BandTilesPanel). Its title shows when the mouse rests on it. -->
        <DataTemplate DataType="{x:Type core:ClipItem}">
            <Border x:Name="Tile" Background="{StaticResource EspressoDeepBrush}" Cursor="Hand" ClipToBounds="True"
                    ContextMenu="{StaticResource ClipMenu}" ToolTip="{Binding Title}"
                    MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseLeave="Tile_MouseLeave" MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                <Grid>
                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <Border x:Name="Ring" BorderBrush="{StaticResource WhiteBrush}" BorderThickness="2" Visibility="Collapsed"/>
                    <Grid x:Name="Play" Width="36" Height="36" Visibility="Collapsed">
                        <Ellipse Fill="#734B3832" Stroke="{StaticResource WhiteBrush}" StrokeThickness="1.3"/>
                        <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE768;" FontSize="13" Foreground="{StaticResource WhiteBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Play" Property="Visibility" Value="Visible"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One band: on Beige its day's name, date and number of clips, then that day's tiles. A band that holds a few
             days lists each of them, newest first like the tiles, in a smaller form. -->
        <DataTemplate x:Key="BandTemplate">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="156"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource BeigeBrush}" Padding="18,14,12,12" ClipToBounds="True">
                    <Grid>
                        <StackPanel x:Name="OneDay" DataContext="{Binding First}">
                            <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BeanBrush}"/>
                            <TextBlock Text="{Binding Date}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="22" Margin="0,3,0,0"/>
                            <TextBlock Text="{Binding CountText}" FontSize="15" Foreground="{StaticResource BeanBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <ItemsControl x:Name="SomeDays" ItemsSource="{Binding Days}" Focusable="False" Visibility="Collapsed">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Label}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BeanBrush}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding Date}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="16" VerticalAlignment="Bottom"/>
                                            <TextBlock Text="{Binding CountText}" FontSize="13.5" Foreground="{StaticResource BeanBrush}" Margin="9,0,0,1" VerticalAlignment="Bottom"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
                <ItemsControl Grid.Column="1" ItemsSource="{Binding Clips}" Margin="2,0,0,0" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <local:BandTilesPanel Columns="{Binding TileColumns, RelativeSource={RelativeSource AncestorType=local:MainWindow}}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCombined}" Value="True">
                    <Setter TargetName="OneDay" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="SomeDays" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A still from the newest clip in the Latest panel; clicking it plays the clip from that moment. -->
        <Style x:Key="FrameButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Margin" Value="0,0,2,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{StaticResource EspressoDeepBrush}" ClipToBounds="True">
                            <ContentPresenter x:Name="Still" Opacity="0.82"/>
                            <Border x:Name="Ring" BorderBrush="{StaticResource WhiteBrush}" BorderThickness="2" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Still" Property="Opacity" Value="1"/>
                                <Setter TargetName="Ring" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A settings section's heading, when a big window shows all four at once: number, name, then a rule. -->
        <Style x:Key="SectionHead" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Margin" Value="0,0,0,26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <DockPanel>
                            <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="10.5"
                                       Foreground="{StaticResource BeanBrush}" VerticalAlignment="Center" Margin="0,3,12,0"/>
                            <ContentPresenter TextElement.FontSize="26" VerticalAlignment="Center"/>
                            <Rectangle Height="1" Fill="{StaticResource BeigeBrush}" VerticalAlignment="Center" Margin="22,4,0,0"/>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings sections, numbered on a thin rule. -->
        <Style x:Key="SectionNav" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Node" Width="11" Height="11" Stroke="{StaticResource BeanBrush}" StrokeThickness="1.3" Fill="{StaticResource CreamBrush}"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="26,0,0,0">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="10.5"
                                           Foreground="{StaticResource BeanBrush}" VerticalAlignment="Center" Margin="0,2,10,0"/>
                                <ContentPresenter x:Name="Name" TextElement.FontSize="17" TextElement.Foreground="{StaticResource BeanBrush}" Opacity="0.8"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Name" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Node" Property="Fill" Value="{StaticResource BeanBrush}"/>
                                <Setter TargetName="Name" Property="Opacity" Value="1"/>
                                <Setter TargetName="Name" Property="TextElement.Foreground" Value="{StaticResource EspressoBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A setting: its name on the left, the control on the right, a hairline under it. -->
        <Style x:Key="SettingLine" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BeigeBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="MinHeight" Value="64"/>
            <Setter Property="Padding" Value="0,12"/>
        </Style>
        <Style x:Key="SettingName" TargetType="TextBlock" BasedOn="{StaticResource Label}">
            <Setter Property="Width" Value="230"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource BeanBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{StaticResource CreamBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- ============================== Header (also the title bar) ============================== -->
            <Grid x:Name="Header">
                <Border BorderBrush="{StaticResource BeigeBrush}" BorderThickness="0,0,0,1"/>
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="FLASH" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/>
                        <TextBlock Text="BACK" FontFamily="{StaticResource MonoFont}" FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton x:Name="NavClips" Style="{StaticResource NavRadio}" GroupName="Nav" Content="CLIPS" IsChecked="True" Checked="NavClips_Checked"/>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavRadio}" GroupName="Nav" Content="SETTINGS" Checked="NavSettings_Checked"/>
                    <Button Style="{StaticResource NavLinkButton}" Content="FOLDER" Click="OpenFolder_Click" ToolTip="Open the clips folder"/>
                </StackPanel>
                <Button x:Name="SaveClipButton" Style="{StaticResource CtaButton}" Click="SaveClip_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,152,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SaveClipText" Text="SAVE CLIP" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource ButtonCircle}">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource WhiteBrush}"/>
                        </Border>
                    </StackPanel>
                </Button>
                <!-- Minimize, maximize and close fill the header's height and meet the window's corner, so the mouse
                     thrown into the top-right corner of the screen lands on Close (see UpdateFrame). -->
                <StackPanel x:Name="CaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="MaxRestore_Click" ToolTip="Maximize"/>
                    <Button x:Name="CloseButton" Style="{StaticResource CaptionCloseButton}" Foreground="{StaticResource BeanBrush}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                </StackPanel>
                <!-- Along the buttons' outer edges the window still resizes, as other windows do; not when maximized. -->
                <Grid x:Name="CaptionGrips" Width="138" HorizontalAlignment="Right">
                    <Border Height="6" VerticalAlignment="Top" Background="Transparent" WindowChrome.ResizeGripDirection="Top"/>
                    <Border Width="6" HorizontalAlignment="Right" Background="Transparent" WindowChrome.ResizeGripDirection="Right"/>
                    <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" WindowChrome.ResizeGripDirection="TopRight"/>
                </Grid>
            </Grid>

            <!-- ============================== Body ============================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Side rail. The stamp (録, "record") is the recording light. -->
                <Border BorderBrush="{StaticResource BeigeBrush}" BorderThickness="0,0,1,0">
                    <DockPanel Margin="0,34,0,18">
                        <Grid DockPanel.Dock="Bottom" Width="30" Height="30" HorizontalAlignment="Center">
                            <Border x:Name="HankoRing" Background="{StaticResource BeanBrush}" Opacity="0.18"/>
                            <Border x:Name="Hanko" Width="24" Height="24" Background="{StaticResource BeanBrush}" BorderBrush="{StaticResource BeanBrush}" BorderThickness="1.3">
                                <TextBlock x:Name="HankoText" Text="録" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource CreamBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <!-- The line runs from under the text down to the stamp, however tall the window is. -->
                        <DockPanel HorizontalAlignment="Center" ClipToBounds="True">
                            <local:VerticalText DockPanel.Dock="Top" TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource BeanBrush}" Spacing="4" Text="過ぎた一瞬を、もう一度。"/>
                            <Rectangle Width="1" Fill="{StaticResource BeanBrush}" Margin="0,12,0,18"/>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <!-- ============================== Clips ============================== -->
                <Grid x:Name="ClipsPage" Grid.Column="1">
                    <ScrollViewer x:Name="ClipsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" ScrollChanged="ClipsScroll_ScrollChanged">
                        <StackPanel>
                            <!-- The newest clip, set out large and uncropped: about 60% of the page's height, with its details
                                 taking the rest of the width (sized in LayoutClips). On a big window the details panel also
                                 shows stills from across the clip. -->
                            <Grid x:Name="Hero" Height="250">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="HeroFigureColumn" Width="444"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{StaticResource EspressoBrush}" ClipToBounds="True">
                                    <Grid>
                                        <Ellipse x:Name="HeroGlow" Width="260" Height="260" Fill="#14DCC7AA" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-70,-90,0"/>
                                        <DockPanel x:Name="HeroDock" Margin="30,24,30,30">
                                            <UniformGrid x:Name="HeroFrames" DockPanel.Dock="Bottom" Columns="6" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                         Visibility="Collapsed" UseLayoutRounding="True"/>
                                            <StackPanel x:Name="HeroDetails" VerticalAlignment="Top">
                                                <TextBlock Text="LATEST" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="44" Foreground="{StaticResource WhiteBrush}"/>
                                                <TextBlock x:Name="HeroWhen" FontSize="17" Foreground="{StaticResource BeigeBrush}" Margin="0,8,0,18" TextTrimming="CharacterEllipsis"/>
                                                <Grid>
                                                    <Rectangle x:Name="HeroDivider" Width="1" Fill="{StaticResource BeigeBrush}" Opacity="0.6" HorizontalAlignment="Left" Margin="85,10,0,18"/>
                                                    <StackPanel>
                                                        <Grid Margin="0,0,0,14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="LENGTH" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BeigeBrush}"/>
                                                                <TextBlock x:Name="HeroLength" Text="—" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource WhiteBrush}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Ellipse Grid.Column="1" Width="11" Height="11" Stroke="{StaticResource BeigeBrush}" StrokeThickness="1.3" Fill="{StaticResource EspressoBrush}"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                            <TextBlock x:Name="HeroLengthWords" Grid.Column="2" FontSize="15" Foreground="{StaticResource CreamBrush}" TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
                                                        </Grid>
                                                        <Grid Margin="0,0,0,14">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="80"/>
                                                                <ColumnDefinition Width="20"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="AUDIO" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="10.5" Foreground="{StaticResource BeigeBrush}"/>
                                                                <TextBlock x:Name="HeroTrackCount" Text="—" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource WhiteBrush}" Margin="0,2,0,0"/>
                                                            </StackPanel>
                                                            <Ellipse Grid.Column="1" Width="11" Height="11" Stroke="{StaticResource BeigeBrush}" StrokeThickness="1.3" Fill="{StaticResource EspressoBrush}"
                                                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                            <TextBlock x:Name="HeroTracks" Grid.Column="2" FontSize="15" Foreground="{StaticResource CreamBrush}" TextTrimming="CharacterEllipsis"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                                <Button Style="{StaticResource LinkButton}" Foreground="{StaticResource BeigeBrush}" Content="WATCH NOW" Click="HeroWatch_Click" Margin="0,2,0,0"
                                                        HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="HeroFigure" Grid.Column="1" Background="{StaticResource EspressoDeepBrush}" Cursor="Hand" ClipToBounds="True"
                                        ContextMenu="{StaticResource ClipMenu}" ToolTip="{Binding Title}"
                                        MouseLeftButtonDown="Tile_MouseLeftButtonDown" MouseLeave="Tile_MouseLeave" MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <!-- A sharper still of the same frame, once it has been made. -->
                                        <Image x:Name="HeroPoster" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <local:VerticalText TextElement.FontSize="13" TextElement.Foreground="{StaticResource CreamBrush}" Spacing="4" Text="記録は、静かに続く。"
                                                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,20,0,0">
                                            <local:VerticalText.Effect>
                                                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Opacity="0.7" Color="Black"/>
                                            </local:VerticalText.Effect>
                                        </local:VerticalText>
                                        <Grid x:Name="HeroPlay" Width="58" Height="58" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse Fill="#594B3832" Stroke="{StaticResource WhiteBrush}" StrokeThickness="1.5"/>
                                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE768;" FontSize="18" Foreground="{StaticResource WhiteBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Every other clip, a band per day; days with only a few clips share one (ClipBand.Group). -->
                            <ItemsControl x:Name="DayList" Margin="0,2,0,0" ItemTemplate="{StaticResource BandTemplate}" Focusable="False"/>
                            <Button x:Name="ShowMoreButton" Style="{StaticResource LinkButton}" Content="SHOW MORE" HorizontalAlignment="Center"
                                    Margin="0,20,0,24" Visibility="Collapsed" Click="ShowMore_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <TextBlock Text="NO CLIPS YET" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="44" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="EmptyHint" FontSize="17" Foreground="{StaticResource BeanBrush}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- ============================== Settings ============================== -->
                <!-- One section at a time, picked on the left; a big window shows all four at once, two by two (LayoutSettings). -->
                <Grid x:Name="SettingsPage" Grid.Column="1" Visibility="Collapsed" SizeChanged="SettingsPage_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SettingsNavColumn" Width="286"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="SettingsNav" BorderBrush="{StaticResource BeigeBrush}" BorderThickness="0,0,1,0" Padding="34,32,24,20">
                        <StackPanel>
                            <TextBlock Text="SETTINGS" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="46" Margin="0,0,0,34"/>
                            <Grid>
                                <Rectangle Width="1" Fill="{StaticResource BeigeBrush}" HorizontalAlignment="Left" Margin="5,10,0,30"/>
                                <StackPanel>
                                    <RadioButton x:Name="SecRecording" Style="{StaticResource SectionNav}" GroupName="Section" Tag="01" Content="Recording" IsChecked="True" Checked="Section_Checked"/>
                                    <RadioButton x:Name="SecVideo" Style="{StaticResource SectionNav}" GroupName="Section" Tag="02" Content="Video" Checked="Section_Checked"/>
                                    <RadioButton x:Name="SecAudio" Style="{StaticResource SectionNav}" GroupName="Section" Tag="03" Content="Audio" Checked="Section_Checked"/>
                                    <RadioButton x:Name="SecGeneral" Style="{StaticResource SectionNav}" GroupName="Section" Tag="04" Content="General" Checked="Section_Checked"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="SettingsBody" Margin="30,30,30,24">
                            <TextBlock x:Name="WideSettingsTitle" Text="SETTINGS" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="46"
                                       Margin="0,0,0,40" Visibility="Collapsed"/>
                            <Grid x:Name="SectionGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition x:Name="SectionGapColumn" Width="0"/>
                                    <ColumnDefinition x:Name="SectionRightColumn" Width="0"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition x:Name="SectionGapRow" Height="0"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <!-- 01 Recording -->
                                <Border x:Name="RecordingCard" Grid.ColumnSpan="3">
                                    <StackPanel x:Name="RecordingSection">
                                        <ContentControl x:Name="RecordingHead" Style="{StaticResource SectionHead}" Tag="01" Content="Recording"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="22"/>
                                                <ColumnDefinition Width="206"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="CLIP LENGTH"/>
                                                <ListBox x:Name="LengthBox" Style="{StaticResource OptionRow}" Margin="0,22,0,0" SelectionChanged="Setting_Changed"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="{StaticResource EspressoBrush}" Padding="18,16" MinHeight="146" ClipToBounds="True">
                                                <Grid>
                                                    <Ellipse Width="170" Height="170" Fill="#14DCC7AA" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-78,-86"/>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Label}" Text="CLIP HOTKEY" Foreground="{StaticResource BeigeBrush}"/>
                                                        <WrapPanel x:Name="HotkeyKeys" Margin="0,14,0,14" MinHeight="44"/>
                                                        <Button x:Name="HotkeyButton" Style="{StaticResource LinkButton}" Foreground="{StaticResource CreamBrush}" Content="CHANGE"
                                                                Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown" LostKeyboardFocus="HotkeyButton_LostFocus"
                                                                ToolTip="Click, then press the keys you want"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <TextBlock x:Name="HotkeyStatus" FontSize="14" Foreground="{StaticResource AlertBrush}" Margin="0,12,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                                        <TextBlock Style="{StaticResource Label}" Text="QUALITY" Margin="0,32,0,6"/>
                                        <ListBox x:Name="QualityBox" Style="{StaticResource TierList}" SelectionChanged="Setting_Changed"/>

                                        <Border BorderBrush="{StaticResource BeigeBrush}" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,16,0,0">
                                            <DockPanel>
                                                <TextBlock Style="{StaticResource Label}" Text="SAVE FOLDER" Margin="0,0,20,0"/>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="BROWSE" Click="BrowseFolder_Click" Margin="16,0,0,0"/>
                                                <TextBlock x:Name="SaveFolderBox" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 02 Video -->
                                <Border x:Name="VideoCard" Grid.ColumnSpan="3">
                                    <StackPanel x:Name="VideoSection" Visibility="Collapsed">
                                        <ContentControl x:Name="VideoHead" Style="{StaticResource SectionHead}" Tag="02" Content="Video"/>
                                        <TextBlock Style="{StaticResource Label}" Text="CLIP RESOLUTION"/>
                                        <ListBox x:Name="ResolutionBox" Style="{StaticResource OptionRow}" Margin="0,22,0,0" SelectionChanged="Setting_Changed"/>
                                        <TextBlock Style="{StaticResource Label}" Text="FRAME RATE" Margin="0,34,0,0"/>
                                        <ListBox x:Name="FpsBox" Style="{StaticResource OptionRow}" Margin="0,22,0,0" Width="280" HorizontalAlignment="Left" SelectionChanged="Setting_Changed"/>
                                        <Border Style="{StaticResource SettingLine}" Margin="0,30,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="SHOW THE MOUSE CURSOR"/>
                                                <CheckBox x:Name="CursorCheck" Style="{StaticResource Switch}" Click="Setting_Changed"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 03 Audio -->
                                <Border x:Name="AudioCard" Grid.ColumnSpan="3">
                                    <StackPanel x:Name="AudioSection" Visibility="Collapsed">
                                        <ContentControl x:Name="AudioHead" Style="{StaticResource SectionHead}" Tag="03" Content="Audio"/>
                                        <Border Style="{StaticResource SettingLine}" BorderThickness="0,1,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="DESKTOP AUDIO"/>
                                                <CheckBox x:Name="DesktopCheck" Style="{StaticResource Switch}" Click="Setting_Changed"/>
                                                <ProgressBar x:Name="DesktopMeter" Style="{StaticResource Meter}" Width="110" Minimum="0" Maximum="1" Margin="22,0,16,0"/>
                                                <TextBlock x:Name="DesktopInfo" Style="{StaticResource Note}" MaxWidth="320"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingLine}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="A TRACK PER APP"/>
                                                <CheckBox x:Name="AppsCheck" Style="{StaticResource Switch}" Click="Setting_Changed"
                                                          ToolTip="Each app gets its own audio track, so you can turn Discord down without touching the game"/>
                                                <TextBlock x:Name="AppsInfo" Style="{StaticResource Note}" Margin="22,0,0,0" MaxWidth="460"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingLine}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="MICROPHONE"/>
                                                <CheckBox x:Name="MicCheck" Style="{StaticResource Switch}" Click="Setting_Changed"/>
                                                <ProgressBar x:Name="MicMeter" Style="{StaticResource Meter}" Width="110" Minimum="0" Maximum="1" Margin="22,0,16,0"/>
                                                <TextBlock x:Name="MicInfo" Style="{StaticResource Note}" MaxWidth="320"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingLine}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="MICROPHONE DEVICE"/>
                                                <ComboBox x:Name="MicDeviceBox" Style="{StaticResource FieldCombo}" Width="360"
                                                          SelectionChanged="Setting_Changed" DropDownOpened="MicDeviceBox_DropDownOpened"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingLine}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="MICROPHONE VOLUME"/>
                                                <Slider x:Name="MicVolumeSlider" Style="{StaticResource ThinSlider}" Width="260" Minimum="0" Maximum="200" SmallChange="5" LargeChange="25"
                                                        VerticalAlignment="Center" ValueChanged="MicVolume_Changed"/>
                                                <TextBlock x:Name="MicVolumeText" Style="{StaticResource Label}" Margin="16,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- 04 General -->
                                <Border x:Name="GeneralCard" Grid.ColumnSpan="3">
                                    <StackPanel x:Name="GeneralSection" Visibility="Collapsed">
                                        <ContentControl x:Name="GeneralHead" Style="{StaticResource SectionHead}" Tag="04" Content="General"/>
                                        <Border Style="{StaticResource SettingLine}" BorderThickness="0,1,0,1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="START WITH WINDOWS"/>
                                                <CheckBox x:Name="StartupCheck" Style="{StaticResource Switch}" Click="Setting_Changed"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingLine}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="KEEP RUNNING IN THE TRAY"/>
                                                <CheckBox x:Name="TrayCheck" Style="{StaticResource Switch}" Click="Setting_Changed"
                                                          ToolTip="Closing the window keeps Flashback recording in the tray"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingLine}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="HOTKEY SOUND"/>
                                                <CheckBox x:Name="SoundCheck" Style="{StaticResource Switch}" Click="Setting_Changed"/>
                                                <TextBlock x:Name="SoundNameText" Style="{StaticResource Note}" Margin="22,0,0,0" MaxWidth="220"/>
                                                <Button x:Name="ChooseSoundButton" Style="{StaticResource LinkButton}" Content="CHOOSE" Margin="22,0,0,0" Click="ChooseSound_Click"
                                                        ToolTip="Any audio file. Its first 5 seconds play; the sound never ends up in the clip."/>
                                                <Button x:Name="PreviewSoundButton" Style="{StaticResource LinkButton}" Content="PLAY" Margin="18,0,0,0" Click="PreviewSound_Click"/>
                                                <Button x:Name="DefaultSoundButton" Style="{StaticResource LinkButton}" Content="DEFAULT" Margin="18,0,0,0" Click="DefaultSound_Click"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingLine}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="NOTICE WHEN SAVED"/>
                                                <CheckBox x:Name="ToastCheck" Style="{StaticResource Switch}" Click="Setting_Changed"
                                                          ToolTip="A small notice in the corner of the screen when a clip is saved"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingLine}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource SettingName}" Text="LOGS"/>
                                                <Button Style="{StaticResource LinkButton}" Content="OPEN LOG FOLDER" Click="OpenLogs_Click"/>
                                                <TextBlock x:Name="VersionText" Style="{StaticResource Label}" Margin="24,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <!-- ============================== Status bar ============================== -->
            <Grid Grid.Row="2" Background="{StaticResource EspressoBrush}">
                <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{StaticResource WhiteBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="9.5" Foreground="{StaticResource CreamBrush}"
                               Margin="8,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusDetail" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource BeigeBrush}"
                               Margin="18,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="560"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AudioStatusText" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource BeigeBrush}" Margin="0,0,18,0"/>
                    <TextBlock x:Name="ReadyText" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource BeigeBrush}"/>
                </StackPanel>
            </Grid>

            <!-- ============================== Player ============================== -->
            <Grid x:Name="PlayerOverlay" Grid.RowSpan="3" Background="{StaticResource EspressoBrush}" Visibility="Collapsed" MouseMove="PlayerOverlay_MouseMove">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid x:Name="PlayerHeader">
                    <Border BorderBrush="{StaticResource DarkLineBrush}" BorderThickness="0,0,0,1"/>
                    <StackPanel Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                        <Image Source="/Assets/logo.png" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FLASH" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource CreamBrush}"/>
                            <TextBlock Text="BACK" FontFamily="{StaticResource MonoFont}" FontSize="10.5" Foreground="{StaticResource CreamBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource NavDarkButton}" Tag="active" Content="CLIPS" Click="PlayerClose_Click" ToolTip="Back to the clips (Esc)"/>
                        <Button Style="{StaticResource NavDarkButton}" Content="SETTINGS" Click="PlayerNavSettings_Click"/>
                        <Button Style="{StaticResource NavDarkButton}" Content="FOLDER" Click="OpenFolder_Click" ToolTip="Open the clips folder"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,152,0"
                                WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CircleButton}" Content="&#xE8B7;" Click="PlayerShowInFolder_Click" ToolTip="Show in folder"/>
                        <Button Style="{StaticResource CircleButton}" Content="&#xE74D;" Click="PlayerDelete_Click" ToolTip="Delete" Margin="8,0,0,0"/>
                        <ProgressBar x:Name="ExportProgress" Style="{StaticResource Meter}" Background="{StaticResource DarkRailBrush}" Foreground="{StaticResource CreamBrush}"
                                     Width="110" Minimum="0" Maximum="1" Margin="18,0,0,0" Visibility="Collapsed"/>
                        <Button x:Name="SaveTrimButton" Style="{StaticResource CtaLightButton}" Click="SaveTrim_Click" Margin="18,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SAVE TRIM" VerticalAlignment="Center"/>
                                <Border Style="{StaticResource ButtonCircle}">
                                    <TextBlock FontFamily="{StaticResource Icons}" Text="&#xE8C6;" FontSize="11" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel x:Name="PlayerCaptionButtons" Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource CaptionButton}" Foreground="{StaticResource CreamBrush}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
                        <Button x:Name="PlayerMaxButton" Style="{StaticResource CaptionButton}" Foreground="{StaticResource CreamBrush}" Content="&#xE922;" Click="MaxRestore_Click" ToolTip="Maximize"/>
                        <Button Style="{StaticResource CaptionCloseButton}" Foreground="{StaticResource CreamBrush}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Close"/>
                    </StackPanel>
                    <Grid x:Name="PlayerCaptionGrips" Width="138" HorizontalAlignment="Right">
                        <Border Height="6" VerticalAlignment="Top" Background="Transparent" WindowChrome.ResizeGripDirection="Top"/>
                        <Border Width="6" HorizontalAlignment="Right" Background="Transparent" WindowChrome.ResizeGripDirection="Right"/>
                        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" WindowChrome.ResizeGripDirection="TopRight"/>
                    </Grid>
                </Grid>

                <Grid x:Name="PlayerBody" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="PlayerRail" BorderBrush="{StaticResource DarkLineBrush}" BorderThickness="0,0,1,0">
                        <DockPanel Margin="0,34,0,18">
                            <Grid DockPanel.Dock="Bottom" Width="30" Height="30" HorizontalAlignment="Center">
                                <Border x:Name="PlayerHankoRing" Background="{StaticResource CreamBrush}" Opacity="0.14"/>
                                <Border x:Name="PlayerHanko" Width="24" Height="24" Background="{StaticResource BeanBrush}" BorderBrush="{StaticResource BeanBrush}" BorderThickness="1.3">
                                    <TextBlock Text="録" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource CreamBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <DockPanel HorizontalAlignment="Center" ClipToBounds="True">
                                <local:VerticalText DockPanel.Dock="Top" TextElement.FontSize="12.5" TextElement.Foreground="{StaticResource BeigeBrush}" Spacing="4" Text="過ぎた一瞬を、もう一度。"/>
                                <Rectangle Width="1" Fill="{StaticResource BeigeBrush}" Opacity="0.6" Margin="0,12,0,18"/>
                            </DockPanel>
                        </DockPanel>
                    </Border>

                    <Grid x:Name="PlayerContent" Grid.Column="1" Margin="24,16,26,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel x:Name="PlayerTitleRow" Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock x:Name="PlayerTime" Text="0:00" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource WhiteBrush}"/>
                                <TextBlock Text=" / " FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource BeigeBrush}"/>
                                <TextBlock x:Name="PlayerTotal" Text="0:00" FontFamily="{StaticResource MonoFont}" FontSize="13" Foreground="{StaticResource BeigeBrush}"/>
                            </StackPanel>
                            <TextBlock x:Name="PlayerTitle" FontFamily="{StaticResource DisplayFont}" FontWeight="Light" FontSize="30" Foreground="{StaticResource WhiteBrush}"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </DockPanel>

                        <Grid x:Name="PlayerSurface" Grid.Row="1" Background="{StaticResource EspressoDeepBrush}" MouseLeftButtonDown="PlayerSurface_MouseDown">
                            <!-- Sizes itself to the clip's shape; centred, the surface around it letterboxes. -->
                            <local:VideoView x:Name="Video" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PlayerError" FontSize="15" Foreground="{StaticResource BeigeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="40" Visibility="Collapsed"/>
                        </Grid>

                        <!-- Transport, then the seek bar right above the timeline, starting and ending where the timeline does so
                             both show the same moment at the same place. In full screen the bar floats over the bottom of the video
                             with the seek bar on top across the whole width, and hides when the mouse rests. -->
                        <Border x:Name="ControlBar" Grid.Row="2" Padding="0,10,0,2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid x:Name="TransportRow">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource CircleButton}" Content="&#xE892;" Click="ToStart_Click" ToolTip="Start (Home)"/>
                                        <Button Style="{StaticResource CircleButton}" Content="&#xE76B;" Click="FrameBack_Click" ToolTip="One frame back (comma)" Margin="8,0,0,0"/>
                                        <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}" Click="PlayPause_Click" ToolTip="Play / pause (Space)" Margin="10,0">
                                            <TextBlock x:Name="PlayPauseGlyph" Text="&#xE769;"/>
                                        </Button>
                                        <Button Style="{StaticResource CircleButton}" Content="&#xE76C;" Click="FrameForward_Click" ToolTip="One frame forward (period)"/>
                                        <Button Style="{StaticResource CircleButton}" Content="&#xE893;" Click="ToEnd_Click" ToolTip="End (End)" Margin="8,0,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="MuteButton" Style="{StaticResource CircleButton}" Click="Mute_Click" ToolTip="Mute (M)">
                                            <TextBlock x:Name="MuteGlyph" Text="&#xE995;"/>
                                        </Button>
                                        <!-- Listening volume for the whole clip. The per-track sliders below set what a saved trim contains. -->
                                        <Slider x:Name="VolumeSlider" Style="{StaticResource ThinSliderDark}" Width="104" Minimum="0" Maximum="100" Value="100" SmallChange="5" LargeChange="10"
                                                VerticalAlignment="Center" Margin="10,0,12,0" Focusable="False"
                                                ValueChanged="Volume_ValueChanged" PreviewMouseWheel="Volume_MouseWheel"
                                                ToolTip="Volume (Up / Down, or the mouse wheel). Saved trims are not affected."/>
                                        <Button x:Name="FullscreenButton" Style="{StaticResource CircleButton}" Click="Fullscreen_Click" ToolTip="Full screen (F)">
                                            <TextBlock x:Name="FullscreenGlyph" Text="&#xE740;"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- The seek bar spans the timeline's own column. In full screen the time shows to its left. -->
                                <Grid x:Name="SeekRow" Grid.Row="1" Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="SeekLabelColumn" Width="{x:Static local:MainWindow.TrackLabelWidth}"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="FsTime" FontFamily="{StaticResource MonoFont}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource CreamBrush}"
                                               VerticalAlignment="Center" Margin="0,0,16,0" Visibility="Collapsed"/>
                                    <!-- Its margin is set in code: widened by half a knob at each end, so 0:00 and the end are where the timeline has them. -->
                                    <Slider x:Name="SeekSlider" Grid.Column="1" Style="{StaticResource ThinSliderDark}" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                            Thumb.DragStarted="Seek_DragStarted" Thumb.DragCompleted="Seek_DragCompleted" ValueChanged="Seek_ValueChanged"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Timeline: volume per track on the left, the ruler, video bar and waveforms on the right. Row heights match the control. -->
                        <Grid x:Name="TimelinePanel" Grid.Row="3" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Static local:MainWindow.TrackLabelWidth}"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <Grid Height="{x:Static local:TimelineControl.RulerHeight}">
                                    <TextBlock x:Name="TrimInfo" Visibility="Collapsed"/>
                                </Grid>
                                <Grid Height="{x:Static local:TimelineControl.VideoHeight}" Margin="0,5,0,0">
                                    <TextBlock Text="VIDEO" FontFamily="{StaticResource MonoFont}" FontSize="10" Foreground="{StaticResource BeigeBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <!-- One row per audio track (each app, the microphone), filled in when a clip opens. -->
                                <StackPanel x:Name="TrackRows"/>
                            </StackPanel>
                            <local:TimelineControl x:Name="Timeline" Grid.Column="1" VerticalAlignment="Top" Focusable="True"/>
                            <Border x:Name="AudioNote" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,4,0" Padding="10,3"
                                    Background="#E63A2B26" Visibility="Collapsed">
                                <TextBlock x:Name="AudioNoteText" FontSize="12" Foreground="{StaticResource BeigeBrush}"/>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
